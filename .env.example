# ── 앱 ──────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Postgres ────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=noti_dev
DB_NAME=notification

# ── Redis ───────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── mock 서버 ───────────────────────────────
MOCK_API_URL=http://mock:4000

# ── 발송 처리량 ──────────────────────────────
# mock 한도 50/s보다 낮게 (429 여유분)
RATE_LIMIT_PER_SEC=45
# 동시에 날아가 있는 요청 수 상한
MAX_IN_FLIGHT=100

# ── 워커 ────────────────────────────────────
# 한 번에 클레임하는 건수
CLAIM_BATCH_SIZE=50
# 클레임 lease 유지 시간(초) — 만료되면 다른 워커가 회수
CLAIM_LEASE_SEC=30
# 일감 없을 때 폴링 간격(ms)
POLL_INTERVAL_MS=1000

# ── 외부 호출 타임아웃 ────────────────────────
# mock의 30초 대기를 기다리지 않음 (slow 3초는 통과)
SEND_TIMEOUT_MS=5000
LOOKUP_TIMEOUT_MS=5000

# ── 재시도 ──────────────────────────────────
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=60000

# ── 사용자 적재 ──────────────────────────────
# mock limit 상한이 1000
USER_PAGE_SIZE=1000